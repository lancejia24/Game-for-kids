import {test} from 'node:test';import {strict as assert} from 'node:assert';import {startWord,apply,isCorrect,normalizeWord,result,displaySlots} from '../src/index.ts';
test('word boundaries',()=>{assert.equal(normalizeWord(' at '),'AT');assert.equal(normalizeWord('strawberry'),'STRAWBERRY');assert.throws(()=>normalizeWord('A'));assert.throws(()=>normalizeWord('ELEPHANTINE'));assert.throws(()=>normalizeWord('ICE CREAM'));});
test('repeated letters remain distinct',()=>{for(const word of ['LETTER','BANANA','STRAWBERRY']){let s=startWord(word,()=>0);assert.equal(new Set(s.tiles.map(t=>t.id)).size,word.length);for(let i=0;i<word.length;i++){const tile=s.tiles.find(t=>t.letter===word[i]&&!s.slots.includes(t.id));assert.ok(tile);s=apply(s,{kind:'place',tileId:tile.id,slot:i});}assert.equal(displaySlots(s),word);assert.equal(isCorrect(s),true);}});
test('swap, return, undo',()=>{let s=startWord('CAT',()=>0);const a=s.tiles[0],b=s.tiles[1];s=apply(s,{kind:'place',tileId:a.id,slot:0});s=apply(s,{kind:'place',tileId:b.id,slot:1});s=apply(s,{kind:'place',tileId:a.id,slot:1});assert.equal(s.slots[0],b.id);assert.equal(s.slots[1],a.id);s=apply(s,{kind:'undo'});assert.equal(s.slots[0],a.id);s=apply(s,{kind:'return',tileId:a.id});assert.equal(s.slots[0],null);});
test('hint disqualifies independent mastery',()=>{let s=startWord('AT',()=>0);for(let i=0;i<2;i++){const tile=s.tiles.find(t=>t.letter==='AT'[i]);s=apply(s,{kind:'place',tileId:tile.id,slot:i});}s=apply(s,{kind:'hint'});s=apply(s,{kind:'check'});assert.equal(result(s).correct,true);assert.equal(result(s).independent,false);});
