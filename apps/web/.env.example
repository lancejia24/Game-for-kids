NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Add only public/publishable Supabase keys. NEVER place a service-role or secret key here.
#
# Optional Azure Speech: produces SYNTHETIC narration, not recordings of humans.
# Configure these in Vercel server environment, NOT NEXT_PUBLIC_*.
WORDPATH_ENABLE_SYNTHETIC_NARRATION=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-JennyNeural
